# Environment Configuration for Render Deployment

# Server Configuration
NODE_ENV=production
PORT=10000

# Frontend URL (Update this with your actual Render frontend URL)
FRONTEND_URL=https://your-frontend-app.onrender.com

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Student Grievance System <your-email@gmail.com>
STAFF_NOTIFICATION_EMAIL=staff@example.com

# Database Configuration (SQLite will work, but you can also use PostgreSQL on Render)
DATABASE_URL=./sgs.db

# Security (Optional)
JWT_SECRET=your-jwt-secret-key
AUTH_TOKEN_TTL_SECONDS=43200
ALLOW_LEGACY_AUTH_TOKENS=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
MAX_JSON_BODY_SIZE=1mb
